<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Анкета</title>
    <style>
        body { font-family: Arial, sans-serif; display: flex; justify-content: center; padding-top: 50px; background: #f0f2f5; }
        form { background: white; padding: 20px; border-radius: 8px; width: 300px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        input, button { width: 100%; padding: 8px; margin-top: 5px; margin-bottom: 15px; box-sizing: border-box; }
        button { cursor: pointer; }
    </style>
</head>
<body>

    <form id="form">
        <h2>Анкета</h2>
        
        <label>Имя:</label>
        <input type="text" id="name">
        
        <label>Группа:</label>
        <input type="text" id="group">
        
        <label>Город:</label>
        <input type="text" id="city">
        
        <button type="button" onclick="save()">Сохранить</button>
        <button type="button" onclick="clearData()">Очистить</button>
    </form>

    <script>
        // При загрузке подставляем данные из localStorage
        ['name', 'group', 'city'].forEach(id => {
            document.getElementById(id).value = localStorage.getItem(id) || '';
        });

        // Сохранение
        function save() {
            ['name', 'group', 'city'].forEach(id => {
                localStorage.setItem(id, document.getElementById(id).value);
            });
            alert('Сохранено!');
        }

        // Очистка
        function clearData() {
            ['name', 'group', 'city'].forEach(id => {
                localStorage.removeItem(id);
                document.getElementById(id).value = '';
            });
            alert('Очищено!');
        }
    </script>

</body>
</html>
