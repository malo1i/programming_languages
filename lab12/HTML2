<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Каталог книг</title>
<style>
body {
    font-family: Arial;
    background: #f0f0f0;
    padding: 20px;
}
h1 {
    text-align: center;
    color: #333;
}
.container {
    background: white;
    padding: 20px;
    width: 70%;
    margin: auto;
    border-radius: 8px;
}
input {
    padding: 8px;
    margin: 5px;
}
button {
    padding: 8px 15px;
    background: #3498db;
    color: white;
    border: none;
    cursor: pointer;
}
.book {
    padding: 10px;
    background: #eee;
    margin: 8px 0;
}
</style>
</head>
<body>

<h1> Каталог книг</h1>

<div class="container">

<h2>Список книг</h2>

<input type="text" id="search" placeholder="Найти книгу">
<button onclick="searchBook()">Поиск</button>

<div id="books">
    <div class="book">Война и мир — Лев Толстой</div>
    <div class="book">Мастер и Маргарита — Булгаков</div>
    <div class="book">Маленький принц — Экзюпери</div>
</div>

<h2>Добавить книгу</h2>

<input type="password" id="pass" placeholder="Пароль">
<br>
<input type="text" id="title" placeholder="Название книги">
<input type="text" id="author" placeholder="Автор">
<br>
<button onclick="addBook()">Добавить</button>

</div>

<script>
function addBook() {
    let pass = document.getElementById("pass").value;
    let title = document.getElementById("title").value;
    let author = document.getElementById("author").value;

    if (pass == "1234" && title != "" && author != "") {
        let book = document.createElement("div");
        book.className = "book";
        book.innerText = title + " — " + author;

        document.getElementById("books").appendChild(book);

        alert("Книга добавлена!");
    } else {
        alert("Проверьте пароль и заполнение полей!");
    }
}

function searchBook() {
    let text = document.getElementById("search").value.toLowerCase();
    let books = document.getElementsByClassName("book");

    for (let book of books) {
        book.style.display = book.innerText.toLowerCase().includes(text)
        ? "block" : "none";
    }
}
</script>

</body>
</html>
